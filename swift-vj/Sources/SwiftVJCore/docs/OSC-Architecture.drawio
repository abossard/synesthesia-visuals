        </mxCell>

        <!-- Producers → Hub -->
        <mxCell id="e-pipeline-to-hub" value="sendToMagic()" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=1;fontSize=9;" edge="1" source="pipeline" target="send-methods" parent="1">
