  <!-- ============================================ -->
  <!-- TAB 2: OSCHub Internal Design -->
  <!-- ============================================ -->
  <diagram id="osc-hub-internal" name="2. OSCHub Internal Design">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="OSCHub — Internal Module Design" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="500" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle2" value="Deep module: simple public API hiding complex subscription routing and concurrency" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="50" width="700" height="25" as="geometry" />
        </mxCell>

        <!-- Public API surface -->
        <mxCell id="api-group" value="Public API (narrow interface)" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="90" width="1300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="api-lifecycle" value="&lt;b&gt;Lifecycle&lt;/b&gt;&#xa;start() / stop()&#xa;running: Bool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="api-group">
          <mxGeometry x="10" y="32" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="api-subscribe" value="&lt;b&gt;Subscriptions&lt;/b&gt;&#xa;subscribe(pattern, handler)&#xa;unsubscribe(pattern)&#xa;clearSubscriptions()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="api-group">
          <mxGeometry x="155" y="32" width="195" height="65" as="geometry" />
        </mxCell>

        <mxCell id="api-send" value="&lt;b&gt;Send&lt;/b&gt;&#xa;sendToVDJ(addr, values?, source?)&#xa;sendToSynesthesia(addr, values?, source?)&#xa;sendToMagic(addr, values?, source?)&#xa;send(addr, host, port, target?, source?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="api-group">
          <mxGeometry x="365" y="32" width="280" height="72" as="geometry" />
        </mxCell>

        <mxCell id="api-stats" value="&lt;b&gt;Monitoring&lt;/b&gt;&#xa;stats() → [String: Any]&#xa;resetStats()&#xa;latencyStats()&#xa;setLatencyMonitoring(enabled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="api-group">
          <mxGeometry x="660" y="32" width="200" height="72" as="geometry" />
        </mxCell>

        <mxCell id="api-callback" value="&lt;b&gt;Observer&lt;/b&gt;&#xa;outgoingMessageHandler:&#xa;  OSCOutgoingMessageHandler?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="api-group">
          <mxGeometry x="875" y="32" width="195" height="55" as="geometry" />
        </mxCell>

        <mxCell id="api-ports" value="&lt;b&gt;Ports (readonly)&lt;/b&gt;&#xa;receivePort, vdjReceivePort,&#xa;vdjPort, synesthesiaPort,&#xa;magicPort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="api-group">
          <mxGeometry x="1085" y="32" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Internal implementation -->
        <mxCell id="impl-group" value="Private Implementation (deep module internals)" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="230" width="1300" height="550" as="geometry" />
        </mxCell>

        <!-- OSCKit dependencies -->
        <mxCell id="osckit-client" value="&lt;b&gt;OSCKit.OSCClient&lt;/b&gt;&#xa;(external library)&#xa;&#xa;UDP send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="20" y="40" width="145" height="65" as="geometry" />
        </mxCell>

        <mxCell id="osckit-server1" value="&lt;b&gt;OSCKit.OSCServer&lt;/b&gt;&#xa;port 9999 (Synesthesia)&#xa;isPortReuseEnabled = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="20" y="120" width="175" height="55" as="geometry" />
        </mxCell>

        <mxCell id="osckit-server2" value="&lt;b&gt;OSCKit.OSCServer&lt;/b&gt;&#xa;port 9010 (VDJ responses)&#xa;isPortReuseEnabled = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="20" y="190" width="175" height="55" as="geometry" />
        </mxCell>

        <!-- Subscription storage -->
        <mxCell id="sub-storage" value="&lt;b&gt;Subscription Storage (3 tiers)&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="impl-group">
          <mxGeometry x="240" y="35" width="250" height="20" as="geometry" />
        </mxCell>

        <mxCell id="any-handlers" value="&lt;b&gt;Tier 1: anyHandlers&lt;/b&gt;&#xa;[OSCMessageHandler]&#xa;&#xa;Patterns: &quot;*&quot;, &quot;/&quot;, &quot;&quot;&#xa;Match: ALL messages&#xa;Priority: checked first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="240" y="60" width="180" height="95" as="geometry" />
        </mxCell>

        <mxCell id="exact-handlers" value="&lt;b&gt;Tier 2: exactHandlers&lt;/b&gt;&#xa;[String: [OSCMessageHandler]]&#xa;&#xa;Pattern: &quot;/audio/level/bass&quot;&#xa;Match: O(1) dict lookup&#xa;Priority: checked second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="440" y="60" width="200" height="95" as="geometry" />
        </mxCell>

        <mxCell id="prefix-trie" value="&lt;b&gt;Tier 3: PrefixTrie&lt;/b&gt;&#xa;PrefixTrie&lt;[OSCMessageHandler]&gt;&#xa;&#xa;Pattern: &quot;/audio/*&quot; stored as &quot;/audio/&quot;&#xa;Match: O(addr.length) trie walk&#xa;Priority: checked third&#xa;Collects ALL matching prefixes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="660" y="60" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- Trie internals -->
        <mxCell id="trie-node" value="&lt;b&gt;PrefixTrieNode&lt;T&gt;&lt;/b&gt;&#xa;children: [Character: Node]&#xa;entries: [PatternEntry&lt;T&gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="910" y="60" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="trie-visual" value="Example Trie Walk:&#xa;&#xa;/ → a → u → d → i → o → / → l → e → v → e → l&#xa;                               ↑ entries here&#xa;&#xa;Pattern &quot;/audio/*&quot; stored at /audio/ node&#xa;Matches: /audio/level/bass, /audio/hits/mid, ..." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="impl-group">
          <mxGeometry x="910" y="130" width="330" height="100" as="geometry" />
        </mxCell>

        <!-- Message handling pipeline -->
        <mxCell id="pipeline-label" value="&lt;b&gt;Message Handling Pipeline&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="impl-group">
          <mxGeometry x="240" y="195" width="250" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="1. handleMessage()&#xa;messagesReceived++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="impl-group">
          <mxGeometry x="240" y="225" width="155" height="45" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="2. forwardMessage()&#xa;→ Magic:11111&#xa;messagesForwarded++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="impl-group">
          <mxGeometry x="420" y="225" width="155" height="55" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="3. dispatchOptimized()&#xa;anyH → exactH → trie&#xa;(snapshot under lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="impl-group">
          <mxGeometry x="600" y="225" width="165" height="55" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="4. latency tracking&#xa;(if enabled)&#xa;CFAbsoluteTimeGetCurrent()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="impl-group">
          <mxGeometry x="790" y="225" width="175" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e-s1-s2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;" edge="1" source="step1" target="step2" parent="impl-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s2-s3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;" edge="1" source="step2" target="step3" parent="impl-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s3-s4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;" edge="1" source="step3" target="step4" parent="impl-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Concurrency model -->
        <mxCell id="conc-label" value="&lt;b&gt;Concurrency Model&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="impl-group">
          <mxGeometry x="240" y="310" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="conc-lock" value="&lt;b&gt;NSLock&lt;/b&gt; protects:&#xa;• subscriptions dict&#xa;• anyHandlers, exactHandlers&#xa;• message counters&#xa;• latency stats&#xa;&#xa;Snapshot pattern: lock → copy&#xa;→ unlock → iterate copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="240" y="340" width="195" height="125" as="geometry" />
        </mxCell>

        <mxCell id="conc-callback" value="&lt;b&gt;Callback Threading&lt;/b&gt;&#xa;&#xa;OSCServer callback → async&#xa;handlers called synchronously&#xa;on server's dispatch queue&#xa;&#xa;outgoingMessageHandler&#xa;called on sender's thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="460" y="340" width="200" height="125" as="geometry" />
        </mxCell>

        <mxCell id="conc-forward" value="&lt;b&gt;Forward Targets&lt;/b&gt;&#xa;(immutable array)&#xa;&#xa;[(&quot;127.0.0.1&quot;, magicPort)]&#xa;&#xa;Fire-and-forget pattern,&#xa;errors silently ignored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="685" y="340" width="175" height="110" as="geometry" />
        </mxCell>

        <!-- Port config -->
        <mxCell id="port-config" value="&lt;b&gt;Port Configuration&lt;/b&gt;&#xa;&#xa;UserDefaults override → fallback to Config.*&#xa;&#xa;Receive: 9999 (Synesthesia), 9010 (VDJ)&#xa;Send: 9009 (VDJ), 7777 (Syn), 11111 (Magic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="impl-group">
          <mxGeometry x="885" y="340" width="240" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

