          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-hub-to-lp" value="/scenes/*, /presets/*, /favslots/*,&#xa;/playlist/*, /controls/meta/*,&#xa;/controls/global/*, /ledfx/*" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=1;fontSize=9;" edge="1" source="dispatch" target="launchpad-mod" parent="1">
          <mxGeometry relative="1" as="geometry" />
