        <mxCell id="vdj-producer" value="Producer: PlaybackEffectsImpl + VDJMonitor" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="out-vdj">
          <mxGeometry x="10" y="265" width="280" height="25" as="geometry" />
