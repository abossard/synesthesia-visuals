        <mxCell id="pipeline" value="&lt;b&gt;PipelineModule&lt;/b&gt;&#xa;(actor, per-track processing)&#xa;&#xa;Sends to Magic (11111):&#xa;/textler/track, /textler/lyrics/*&#xa;/textler/refrain/*, /textler/keywords/*&#xa;/textler/metadata/*, /ai/analysis&#xa;/shader/load, /image/fit, /image/folder&#xa;&#xa;Rate: ~50-200 msgs per track&#xa;Gated by RenderOutputsState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="producer-group">
          <mxGeometry x="20" y="40" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="playback-effects" value="&lt;b&gt;PlaybackEffectsImpl&lt;/b&gt;&#xa;&#xa;Sends to VDJ (9009):&#xa;/vdj/subscribe/deck/{1,2}/*&#xa;/vdj/query/deck/{1,2}/*&#xa;&#xa;Rate: subscription + 1Hz poll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="producer-group">
          <mxGeometry x="330" y="40" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="launchpad-send" value="&lt;b&gt;LaunchpadEffectsImpl&lt;/b&gt;&#xa;&#xa;Sends OSC events as actions&#xa;via EffectEnvironment.sendOSC&#xa;&#xa;Target: varies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="producer-group">
          <mxGeometry x="580" y="40" width="195" height="95" as="geometry" />
        </mxCell>

        <mxCell id="effect-env" value="&lt;b&gt;EffectEnvironment&lt;/b&gt;&#xa;(@MainActor, dependency injection)&#xa;&#xa;sendOSC: (target, addr, args, source)&#xa;  → routes to OSCHub.send*()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="producer-group">
          <mxGeometry x="805" y="40" width="250" height="85" as="geometry" />
        </mxCell>

        <mxCell id="store-actions" value="&lt;b&gt;Store Actions ↔ Effects&lt;/b&gt;&#xa;&#xa;UIAction.oscMessageReceived&#xa;LaunchpadAction.oscEventReceived&#xa;AutomationAction.recordOSC&#xa;&#xa;→ dispatched via Reducer → Effect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="producer-group">
          <mxGeometry x="1085" y="40" width="225" height="115" as="geometry" />
