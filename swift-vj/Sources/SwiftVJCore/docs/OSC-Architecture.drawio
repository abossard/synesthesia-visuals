        </mxCell>

        <mxCell id="addr-energy" value="/audio/energy/intensity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="in-audio">
          <mxGeometry x="475" y="135" width="165" height="30" as="geometry" />
        </mxCell>

        <mxCell id="audio-consumer" value="Consumer: SynesthesiaAudioProcessor&#xa;Threading: os_unfair_lock accumulator&#xa;Transform: → OSCAudioLevels → AudioState → Metal uniforms" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="in-audio">
