        <mxCell id="out-vdj" value="OUTGOING: VDJ Subscriptions &amp; Queries (→ port 9009)" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1310" y="80" width="400" height="310" as="geometry" />
        </mxCell>

        <mxCell id="addr-sub" value="/vdj/subscribe/deck/1/get_title&#xa;/vdj/subscribe/deck/1/get_artist&#xa;/vdj/subscribe/deck/1/get_album&#xa;/vdj/subscribe/deck/1/get_bpm&#xa;/vdj/subscribe/deck/1/get_songlength&#xa;/vdj/subscribe/deck/1/loaded&#xa;... (same for deck/2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-vdj">
