        <mxCell id="e-playback-to-hub" value="sendToVDJ()" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=1;fontSize=9;" edge="1" source="playback-effects" target="send-methods" parent="1">
