  <!-- ============================================ -->
  <!-- TAB 1: OSC System-Level Architecture -->
  <!-- ============================================ -->
  <diagram id="osc-system" name="1. OSC System Architecture">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="OSC System Architecture — SwiftVJCore" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Central OSCHub with dual servers, prefix-trie routing, and forwarding to Magic" style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="55" width="800" height="25" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- EXTERNAL SYSTEMS -->
        <!-- ============================================ -->
        <mxCell id="ext-group" value="External Systems" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="2100" height="130" as="geometry" />
        </mxCell>

        <mxCell id="synesthesia" value="&lt;b&gt;Synesthesia&lt;/b&gt;&#xa;VJ Software&#xa;&#xa;OSC port 9999 (sends audio)&#xa;OSC port 7777 (receives)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="ext-group">
          <mxGeometry x="30" y="30" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="vdj" value="&lt;b&gt;VirtualDJ&lt;/b&gt;&#xa;DJ Software&#xa;&#xa;OSC port 9009 (receives)&#xa;OSC port 9010 (responds)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="ext-group">
          <mxGeometry x="470" y="30" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="magic" value="&lt;b&gt;Magic Music Visuals&lt;/b&gt;&#xa;(Textler Rendering)&#xa;&#xa;OSC port 11111 (receives)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="ext-group">
          <mxGeometry x="910" y="30" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="launchpad" value="&lt;b&gt;Launchpad&lt;/b&gt;&#xa;MIDI Controller&#xa;(native CoreMIDI, not OSC)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="ext-group">
          <mxGeometry x="1350" y="30" width="190" height="75" as="geometry" />
        </mxCell>

        <mxCell id="ledfx" value="&lt;b&gt;LedFX&lt;/b&gt;&#xa;LED Controller&#xa;&#xa;REST API :8888" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="ext-group">
          <mxGeometry x="1780" y="30" width="170" height="75" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- OSCHub (Central) -->
        <!-- ============================================ -->
        <mxCell id="hub-group" value="OSCHub — Central OSC Transport (class, @unchecked Sendable)" style="swimlane;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="1200" height="340" as="geometry" />
        </mxCell>

        <!-- Receive side -->
        <mxCell id="server-9999" value="&lt;b&gt;OSCServer&lt;/b&gt;&#xa;port 9999&#xa;(Synesthesia audio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="hub-group">
          <mxGeometry x="20" y="45" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="server-9010" value="&lt;b&gt;OSCServer&lt;/b&gt;&#xa;port 9010&#xa;(VDJ responses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="hub-group">
          <mxGeometry x="20" y="115" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- Message handler -->
        <mxCell id="handler" value="&lt;b&gt;handleMessage()&lt;/b&gt;&#xa;&#xa;1. messagesReceived++&#xa;2. forwardMessage() → Magic&#xa;3. dispatchMessageOptimized()&#xa;4. track latency (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="hub-group">
          <mxGeometry x="220" y="45" width="210" height="95" as="geometry" />
        </mxCell>

        <!-- Dispatch engine -->
        <mxCell id="dispatch" value="&lt;b&gt;dispatchMessageOptimized()&lt;/b&gt;&#xa;&#xa;1. anyHandlers[] → broadcast (*, /)&#xa;2. exactHandlers[addr] → exact match&#xa;3. prefixTrie.match(addr) → O(n) prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="hub-group">
          <mxGeometry x="220" y="160" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Trie -->
        <mxCell id="trie" value="&lt;b&gt;PrefixTrie&lt;[Handler]&gt;&lt;/b&gt;&#xa;&#xa;Character-by-character walk&#xa;Collects entries at each node&#xa;O(address.length) matching&#xa;Thread-safe (NSLock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="hub-group">
          <mxGeometry x="220" y="255" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Send side -->
        <mxCell id="client" value="&lt;b&gt;OSCClient&lt;/b&gt;&#xa;(OSCKit)&#xa;&#xa;Sends to VDJ, Synesthesia,&#xa;Magic, custom targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="hub-group">
          <mxGeometry x="530" y="45" width="175" height="80" as="geometry" />
        </mxCell>

        <mxCell id="send-methods" value="&lt;b&gt;Send Methods&lt;/b&gt;&#xa;&#xa;sendToVDJ()       → 127.0.0.1:9009&#xa;sendToSynesthesia() → 127.0.0.1:7777&#xa;sendToMagic()     → 127.0.0.1:11111&#xa;send(host, port)  → custom target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="hub-group">
          <mxGeometry x="530" y="145" width="260" height="95" as="geometry" />
        </mxCell>

        <!-- Forward -->
        <mxCell id="forward" value="&lt;b&gt;Auto-Forward&lt;/b&gt;&#xa;All received → Magic (11111)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" vertex="1" parent="hub-group">
          <mxGeometry x="530" y="260" width="175" height="40" as="geometry" />
        </mxCell>

        <!-- Stats & monitor -->
        <mxCell id="stats" value="&lt;b&gt;Stats &amp; Monitoring&lt;/b&gt;&#xa;&#xa;messagesSent / Received / Forwarded&#xa;latencyStats (avg, max, count)&#xa;outgoingMessageHandler callback&#xa;(all protected by NSLock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="hub-group">
          <mxGeometry x="840" y="45" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="subscribe-api" value="&lt;b&gt;subscribe(pattern, handler)&lt;/b&gt;&#xa;&#xa;classifyPattern()&#xa;  ├ any: *, / → anyHandlers&#xa;  ├ exact: /path → exactHandlers&#xa;  └ prefix: /p* → prefixTrie&#xa;&#xa;&lt;b&gt;unsubscribe(pattern)&lt;/b&gt;&#xa;&lt;b&gt;clearSubscriptions()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="hub-group">
          <mxGeometry x="840" y="165" width="220" height="145" as="geometry" />
        </mxCell>

        <!-- Internal edges in hub -->
        <mxCell id="e-srv1-handler" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=1;" edge="1" source="server-9999" target="handler" parent="hub-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-srv2-handler" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=1;" edge="1" source="server-9010" target="handler" parent="hub-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-handler-dispatch" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=1;" edge="1" source="handler" target="dispatch" parent="hub-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dispatch-trie" value="prefix lookup" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=1;dashed=1;fontSize=9;" edge="1" source="dispatch" target="trie" parent="hub-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- CONSUMERS (Subscribers) -->
        <!-- ============================================ -->
        <mxCell id="consumer-group" value="OSC Consumers — Subscribers to OSCHub" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="1900" height="250" as="geometry" />
        </mxCell>

        <mxCell id="audio-proc" value="&lt;b&gt;SynesthesiaAudioProcessor&lt;/b&gt;&#xa;(actor + os_unfair_lock accumulator)&#xa;&#xa;Pattern: /audio/*&#xa;Rate: 300+ msg/s&#xa;&#xa;→ OSCAudioLevels&#xa;→ AudioState (rendering)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="20" y="40" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="vdj-monitor" value="&lt;b&gt;VDJMonitor&lt;/b&gt;&#xa;(actor)&#xa;&#xa;Pattern: /deck/*, /vdj/*,&#xa;  /crossfader&#xa;Rate: event-driven + 1Hz poll&#xa;&#xa;→ VDJDeck → VDJPlayback&#xa;→ PlaybackState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="270" y="40" width="215" height="145" as="geometry" />
        </mxCell>

        <mxCell id="launchpad-mod" value="&lt;b&gt;LaunchpadModule&lt;/b&gt;&#xa;(class, DispatchQueue)&#xa;&#xa;Patterns: /scenes/*, /presets/*,&#xa;  /favslots/*, /playlist/*,&#xa;  /controls/meta/*, /controls/global/*,&#xa;  /ledfx/*&#xa;Input: native CoreMIDI (not OSC)&#xa;&#xa;→ DynamicControlStore&#xa;→ Learn mode capture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="515" y="40" width="210" height="145" as="geometry" />
        </mxCell>

        <mxCell id="osc-debug" value="&lt;b&gt;OSC Debug View&lt;/b&gt;&#xa;(via oscHub.subscribe(&amp;quot;*&amp;quot;))&#xa;&#xa;Pattern: * (all incoming)&#xa;Records incoming messages&#xa;Filter by substring match&#xa;Toggle audio messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="735" y="40" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="bridge-consumer" value="&lt;b&gt;OscRestBridgeService&lt;/b&gt;&#xa;(actor)&#xa;&#xa;Pattern: /ledfx/*&#xa;Rate: event-driven&#xa;&#xa;→ ParsedOSCRoute&#xa;→ HTTPRequestPlan → REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="965" y="40" width="210" height="125" as="geometry" />
        </mxCell>

        <mxCell id="automation" value="&lt;b&gt;AutomationReducer&lt;/b&gt;&#xa;(NOT an OSCHub subscriber)&#xa;&#xa;Records OUTGOING OSC via&#xa;outgoingMessageHandler callback&#xa;for song timeline replay&#xa;&#xa;→ AutomationCue per (timeSec,&#xa;   target, addr, args)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="1205" y="40" width="195" height="145" as="geometry" />
        </mxCell>

        <mxCell id="image-handler" value="&lt;b&gt;Image Folder Handler&lt;/b&gt;&#xa;&#xa;Pattern: /image/folder&#xa;Exact match (not prefix)&#xa;&#xa;→ loadImagesFromFolder()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="1430" y="40" width="185" height="95" as="geometry" />
        </mxCell>

        <mxCell id="render-handler" value="&lt;b&gt;Render Toggle Handler&lt;/b&gt;&#xa;&#xa;Pattern: /render/enabled&#xa;Exact match (not prefix)&#xa;&#xa;→ setRenderEnabled()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="consumer-group">
          <mxGeometry x="1645" y="40" width="185" height="95" as="geometry" />
        </mxCell>
        </mxCell>

        <!-- ============================================ -->
        <!-- PRODUCERS (send via OSCHub) -->
        <!-- ============================================ -->
        <mxCell id="producer-group" value="OSC Producers — Send via OSCHub" style="swimlane;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
