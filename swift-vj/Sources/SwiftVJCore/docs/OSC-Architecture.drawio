        <!-- Bridge → LedFX -->
        <mxCell id="e-bridge-to-ledfx" value="REST API calls" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;fontSize=9;" edge="1" source="bridge-consumer" target="ledfx" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
