        <!-- Hub → Consumers -->
        <mxCell id="e-hub-to-audio" value="/audio/*" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;" edge="1" source="dispatch" target="audio-proc" parent="1">
