        <mxCell id="e-hub-to-bridge" value="/ledfx/*" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=1;fontSize=9;" edge="1" source="dispatch" target="bridge-consumer" parent="1">
