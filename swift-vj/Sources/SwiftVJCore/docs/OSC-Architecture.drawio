        <!-- OUTGOING MAGIC / TEXTLER -->
        <mxCell id="out-magic" value="OUTGOING: Pipeline → Magic (→ port 11111, 50-200 msgs/track)" style="swimlane;startSize=25;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="900" height="380" as="geometry" />
        </mxCell>

        <mxCell id="addr-textler-track" value="/textler/track  [active, source, artist, title,&#xa;                 album, duration, has_lyrics]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-magic">
          <mxGeometry x="10" y="35" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="addr-textler-lyrics" value="/textler/lyrics/reset&#xa;/textler/lyrics/line  [index, timeSec, text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-magic">
          <mxGeometry x="10" y="85" width="350" height="40" as="geometry" />
        </mxCell>

        <mxCell id="addr-textler-refrain" value="/textler/refrain/reset&#xa;/textler/refrain/line  [index, timeSec, text]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-magic">
          <mxGeometry x="10" y="135" width="350" height="40" as="geometry" />
        </mxCell>

        <mxCell id="addr-textler-kw" value="/textler/keywords/reset&#xa;/textler/keywords/line  [index, timeSec, keywords]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-magic">
          <mxGeometry x="10" y="185" width="365" height="40" as="geometry" />
        </mxCell>

        <mxCell id="addr-metadata" value="/textler/metadata/keywords  [comma-separated]&#xa;/textler/metadata/themes    [comma-separated]&#xa;/textler/metadata/visuals   [comma-separated]&#xa;/textler/metadata/mood      [string]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-magic">
          <mxGeometry x="10" y="235" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="addr-ai-shader" value="/ai/analysis    [mood, energy, valence]&#xa;/shader/load    [name, energyScore, moodValence]&#xa;/image/fit      [cover]&#xa;/image/folder   [path]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-magic">
          <mxGeometry x="10" y="315" width="380" height="55" as="geometry" />
        </mxCell>

        <mxCell id="magic-gates" value="&lt;b&gt;Output Gating&lt;/b&gt;&#xa;&#xa;Each address group is independently&#xa;gated by RenderOutputsState:&#xa;&#xa;✓/✗ shaderOutputEnabled → /shader/load&#xa;✓/✗ imageOutputEnabled  → /image/*&#xa;✓/✗ lyricsOutputEnabled → /textler/lyrics/*, /textler/track&#xa;✓/✗ refrainOutputEnabled → /textler/refrain/*&#xa;✓/✗ songInfoOutputEnabled → /textler/metadata/*, /ai/*" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="out-magic">
          <mxGeometry x="460" y="35" width="410" height="150" as="geometry" />
        </mxCell>

        <mxCell id="magic-producer" value="Producer: PipelineModule (actor)&#xa;Triggered by: track change → analyze → broadcast" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="out-magic">
          <mxGeometry x="460" y="205" width="310" height="35" as="geometry" />
        </mxCell>

        <!-- LEDFX BRIDGE -->
        <mxCell id="out-ledfx" value="INTERNAL: OscRestBridge (OSC → REST, event-driven)" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="420" width="440" height="250" as="geometry" />
        </mxCell>

        <mxCell id="addr-ledfx" value="/ledfx/scene/{sceneName}/{slot}     [0 or 1]&#xa;/ledfx/playlist/{id}/{slot}          [1]&#xa;/ledfx/playlist_control/{action}/{slot}&#xa;/ledfx/oneshot/{name}/{slot}         [1]&#xa;/ledfx/blackout/{slot}               [0 or 1]&#xa;/ledfx/param/{paramName}/{slot}      [0-127]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="out-ledfx">
          <mxGeometry x="10" y="35" width="410" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ledfx-note" value="Consumer: OscRestBridgeService (actor)&#xa;Transform: OSC → ParsedOSCRoute → RequestBuilder&#xa;  → TemplateEngine → JSONPatcher → HTTPRequestPlan&#xa;  → REST API call to LedFX (:8888)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="out-ledfx">
          <mxGeometry x="10" y="155" width="350" height="65" as="geometry" />
        </mxCell>

        <!-- AUTO-FORWARD -->
        <mxCell id="auto-fwd" value="AUTO-FORWARD: All port 9999 messages → Magic:11111" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="700" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="fwd-note" value="Every message received on port 9999 (Synesthesia audio)&#xa;is automatically re-sent to Magic (port 11111).&#xa;Errors silently ignored (fire-and-forget)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="auto-fwd">
          <mxGeometry x="10" y="35" width="410" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================ -->
  <!-- TAB 4: Sequence - Audio Flow -->
  <!-- ============================================ -->
  <diagram id="seq-audio" name="4. Flow: Synesthesia Audio (60 FPS)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="seq-audio-title" value="Sequence: Real-Time Audio OSC (300+ msg/s, os_unfair_lock Pipeline)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll-syn" value="Synesthesia&#xa;(port 9999)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#dae8fc;strokeColor=#6c8ebf;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="110" height="950" as="geometry" />
        </mxCell>
        <mxCell id="ll-hub" value="OSCHub&#xa;(server 9999)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="70" width="120" height="950" as="geometry" />
        </mxCell>
        <mxCell id="ll-magic-fwd" value="Magic&#xa;(forward :11111)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#fff2cc;strokeColor=#d6b656;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="70" width="120" height="950" as="geometry" />
        </mxCell>
        <mxCell id="ll-audio" value="Synesthesia&#xa;AudioProcessor&#xa;(os_unfair_lock)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#dae8fc;strokeColor=#6c8ebf;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="130" height="950" as="geometry" />
        </mxCell>
        <mxCell id="ll-accum" value="OSCAccumulator&#xa;(os_unfair_lock)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#f8cecc;strokeColor=#b85450;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="70" width="130" height="950" as="geometry" />
        </mxCell>
        <mxCell id="ll-render" value="Render Loop&#xa;(Metal, 60 FPS)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#d5e8d4;strokeColor=#82b366;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="70" width="120" height="950" as="geometry" />
        </mxCell>
        <mxCell id="ll-shader" value="Shader Uniforms&#xa;(AudioState)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#d5e8d4;strokeColor=#82b366;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="70" width="130" height="950" as="geometry" />
        </mxCell>

        <!-- High-rate loop -->
        <mxCell id="loop1" value="loop [300+ msg/s from Synesthesia]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=200;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="870" height="350" as="geometry" />
        </mxCell>

        <!-- Message arrives -->
        <mxCell id="a1" value="/audio/level/bass [0.73]" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="180" as="sourcePoint" />
            <mxPoint x="320" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Forward to Magic -->
        <mxCell id="a2" value="forward (fire &amp; forget)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;strokeColor=#d6b656;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="210" as="sourcePoint" />
            <mxPoint x="520" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Dispatch to handler -->
        <mxCell id="a3" value="prefixTrie.match(&quot;/audio/level/bass&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="250" as="sourcePoint" />
            <mxPoint x="380" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a3note" value="Pattern &quot;/audio/*&quot;&#xa;matched at trie node" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="390" y="250" width="130" height="35" as="geometry" />
        </mxCell>

        <!-- Call handler -->
        <mxCell id="a4" value="handleOSCFast(addr, values)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="310" as="sourcePoint" />
            <mxPoint x="725" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a4note" value="nonisolated — no actor hop!&#xa;Runs on OSCServer thread" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="530" y="320" width="170" height="35" as="geometry" />
        </mxCell>

        <!-- Accumulator write -->
        <mxCell id="a5" value="os_unfair_lock { accum.bass = 0.73 }" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="380" as="sourcePoint" />
            <mxPoint x="935" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a5note" value="Lock held &lt; 1μs&#xa;No allocation, no copy&#xa;Just field assignment" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="740" y="395" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- unlock & return -->
        <mxCell id="a5r" value="" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="935" y="460" as="sourcePoint" />
            <mxPoint x="725" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Render loop -->
        <mxCell id="loop2" value="loop [60 FPS render frame]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=140;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="520" width="700" height="380" as="geometry" />
        </mxCell>

        <!-- Read snapshot -->
        <mxCell id="a6" value="getLevels() (once per frame)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="570" as="sourcePoint" />
            <mxPoint x="725" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a7" value="os_unfair_lock { snapshot = accum; reset }" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="610" as="sourcePoint" />
            <mxPoint x="935" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a7r" value="OSCAudioLevels (snapshot)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="935" y="640" as="sourcePoint" />
            <mxPoint x="725" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a8" value="OSCAudioLevels" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="670" as="sourcePoint" />
            <mxPoint x="1140" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Transform to AudioState -->
        <mxCell id="a9note" value="Pure calculation (no side effects):&#xa;lerp, clamp, smoothing&#xa;calcSyntheticMouse()&#xa;beatPhase, kickEnvelope" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1155" y="690" width="180" height="65" as="geometry" />
        </mxCell>

        <!-- Set uniforms -->
        <mxCell id="a10" value="setUniforms(AudioState)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="780" as="sourcePoint" />
            <mxPoint x="1345" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a10note" value="syn_Level, syn_BassLevel&#xa;syn_BeatTime, syn_BPM&#xa;syn_BpmTwitcher&#xa;→ Metal shader uniforms" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="800" width="170" height="65" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================ -->
  <!-- TAB 5: Sequence - VDJ Track Detection -->
  <!-- ============================================ -->
  <diagram id="seq-vdj" name="5. Flow: VDJ Track Detection &amp; Pipeline">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="seq-vdj-title" value="Sequence: VDJ Track Change → Pipeline → Magic Broadcast" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="lv-vdj" value="VirtualDJ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#d5e8d4;strokeColor=#82b366;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="100" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="lv-hub" value="OSCHub" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="100" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="lv-vdjmon" value="VDJMonitor&#xa;(actor)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#d5e8d4;strokeColor=#82b366;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="110" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="lv-playback" value="Playback&#xa;Module" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#d5e8d4;strokeColor=#82b366;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="70" width="110" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="lv-store" value="Store&#xa;(Reducer)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#f5f5f5;strokeColor=#666666;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="100" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="lv-pipeline" value="Pipeline&#xa;Module" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#fff2cc;strokeColor=#d6b656;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="70" width="100" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="lv-hub2" value="OSCHub&#xa;(send)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="70" width="100" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="lv-magic" value="Magic&#xa;(Textler)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#fff2cc;strokeColor=#d6b656;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="70" width="100" height="1050" as="geometry" />
        </mxCell>

        <!-- Step 1: VDJ sends subscription response -->
        <mxCell id="v1" value="/deck/1/artist [&quot;Queen&quot;]" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="160" as="sourcePoint" />
            <mxPoint x="270" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v2" value="dispatch → /deck/* handler" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="195" as="sourcePoint" />
            <mxPoint x="455" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v3" value="/deck/1/title [&quot;Bohemian Rhapsody&quot;]" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="230" as="sourcePoint" />
            <mxPoint x="455" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v3note" value="VDJMonitor accumulates fields&#xa;into VDJDeck struct (actor-isolated)&#xa;Infers audibility from volume +&#xa;position changes" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="470" y="240" width="215" height="65" as="geometry" />
        </mxCell>

        <!-- Track change detected -->
        <mxCell id="v4" value="trackChanged(deck1)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="455" y="340" as="sourcePoint" />
            <mxPoint x="635" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v5" value="VDJPlayback → PlaybackState" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="480" y="350" width="200" height="25" as="geometry" />
        </mxCell>

        <!-- Dispatch action -->
        <mxCell id="v6" value="dispatch(.playback(.trackChanged(track)))" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="635" y="410" as="sourcePoint" />
            <mxPoint x="810" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v7note" value="Reducer:&#xa;• state.playback.track = track&#xa;• Returns Effect:&#xa;  pipeline.processTrack(track)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="830" y="420" width="215" height="60" as="geometry" />
        </mxCell>

        <!-- Pipeline processes -->
        <mxCell id="v8" value="processTrack(track)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="510" as="sourcePoint" />
            <mxPoint x="990" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v8note" value="Pipeline steps (async):&#xa;1. Fetch lyrics (LRCLib → LLM fallback)&#xa;2. AI analysis (mood, energy, valence)&#xa;3. Shader selection (energy → shader)&#xa;4. Image scraping (album cover)&#xa;5. Broadcast results via OSC" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="520" width="250" height="90" as="geometry" />
        </mxCell>

        <!-- OSC broadcast -->
        <mxCell id="v9" value="sendToMagic(&quot;/textler/track&quot;, [...])" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="650" as="sourcePoint" />
            <mxPoint x="1170" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v9b" value="→ Magic" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="670" as="sourcePoint" />
            <mxPoint x="1350" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v10" value="sendToMagic(&quot;/textler/lyrics/line&quot;, [n, t, text])" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="710" as="sourcePoint" />
            <mxPoint x="1170" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v10b" value="→ Magic" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="730" as="sourcePoint" />
            <mxPoint x="1350" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v10note" value="repeat for each lyric line&#xa;(50-200 messages)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="740" width="150" height="35" as="geometry" />
        </mxCell>

        <mxCell id="v11" value="sendToMagic(&quot;/shader/load&quot;, [name, energy, valence])" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="800" as="sourcePoint" />
            <mxPoint x="1170" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v11b" value="→ Magic" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="820" as="sourcePoint" />
            <mxPoint x="1350" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v12" value="sendToMagic(&quot;/ai/analysis&quot;, [mood, energy, valence])" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="860" as="sourcePoint" />
            <mxPoint x="1170" y="860" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v12b" value="→ Magic" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="880" as="sourcePoint" />
            <mxPoint x="1350" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Completion -->
        <mxCell id="v13" value="dispatch(.pipeline(.processingCompleted))" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="940" as="sourcePoint" />
            <mxPoint x="810" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================ -->
  <!-- TAB 6: Sequence - OSCHub Startup -->
  <!-- ============================================ -->
  <diagram id="seq-startup" name="6. Flow: OSCHub Lifecycle &amp; Subscription">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="seq-start-title" value="Sequence: OSCHub Startup, Subscription Wiring &amp; Shutdown" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ls-app" value="App Launch" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#f5f5f5;strokeColor=#666666;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="100" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ls-hub" value="OSCHub" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="100" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ls-osckit" value="OSCKit&#xa;(External)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#dae8fc;strokeColor=#6c8ebf;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="70" width="100" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ls-audio" value="Synesthesia&#xa;AudioProcessor" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#dae8fc;strokeColor=#6c8ebf;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="70" width="130" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ls-vdjmon" value="VDJMonitor" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#d5e8d4;strokeColor=#82b366;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="100" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ls-bridge" value="OscRestBridge&#xa;Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#f8cecc;strokeColor=#b85450;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="70" width="120" height="850" as="geometry" />
        </mxCell>

        <!-- Init -->
        <mxCell id="s1" value="OSCHub()" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="150" as="sourcePoint" />
            <mxPoint x="300" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="s1note" value="Reads UserDefaults for port overrides&#xa;Falls back to Config.* constants" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="155" width="220" height="35" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="s2" value="try hub.start()" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="220" as="sourcePoint" />
            <mxPoint x="300" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Create servers -->
        <mxCell id="s3" value="OSCServer(port: 9999) + start()" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="255" as="sourcePoint" />
            <mxPoint x="490" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s4" value="OSCServer(port: 9010) + start()" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="290" as="sourcePoint" />
            <mxPoint x="490" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s5" value="OSCClient() + start()" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="325" as="sourcePoint" />
            <mxPoint x="490" y="325" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="s5note" value="isStarted = true&#xa;Rollback: if any fails,&#xa;stop previously started" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="340" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- Wire subscribers -->
        <mxCell id="s6" value="subscribe(&quot;/audio/*&quot;, audioHandler)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="695" y="420" as="sourcePoint" />
            <mxPoint x="300" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s6note" value="→ prefixTrie.add(&quot;/audio/&quot;, handler)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="220" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="subscribe(&quot;/deck/*&quot;, &quot;/vdj/*&quot;, &quot;/crossfader&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="480" as="sourcePoint" />
            <mxPoint x="300" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7note" value="→ prefixTrie: /deck/, /vdj/; exact: /crossfader" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="490" width="215" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="subscribe(&quot;/ledfx/*&quot;, bridgeHandler)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="540" as="sourcePoint" />
            <mxPoint x="300" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s8note" value="→ prefixTrie.add(&quot;/ledfx/&quot;, handler)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="550" width="215" height="25" as="geometry" />
        </mxCell>

        <!-- Running state -->
        <mxCell id="running-note" value="OSCHub now running:&#xa;• 2 servers listening (9999, 9010)&#xa;• 1 client ready to send&#xa;• N subscriptions in trie&#xa;• Auto-forward to Magic:11111" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="600" width="200" height="85" as="geometry" />
        </mxCell>

        <!-- Shutdown -->
        <mxCell id="sep-line" value="" style="line;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="710" width="1120" height="10" as="geometry" />
        </mxCell>
        <mxCell id="sep-label" value="[app shutdown]" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="50" y="720" width="100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="hub.stop()" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="760" as="sourcePoint" />
            <mxPoint x="300" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="s10" value="client.stop()&#xa;server.stop()&#xa;vdjServer.stop()" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="795" as="sourcePoint" />
            <mxPoint x="490" y="795" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="s10note" value="isStarted = false&#xa;All refs set to nil" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="810" width="140" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================ -->
  <!-- TAB 7: Sequence - Output Gating -->
  <!-- ============================================ -->
  <diagram id="seq-gating" name="7. Flow: Output Gating (RenderOutputsState)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="seq-gate-title" value="Sequence: Pipeline Output Gating via RenderOutputsState" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="550" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="lg-pipeline" value="Pipeline&#xa;Module" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#fff2cc;strokeColor=#d6b656;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="lg-policy" value="Execution&#xa;Policy" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#f5f5f5;strokeColor=#666666;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="lg-hub" value="OSCHub&#xa;(send)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#e1d5e7;strokeColor=#9673a6;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="lg-magic" value="Magic" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#fff2cc;strokeColor=#d6b656;size=40;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="80" height="750" as="geometry" />
        </mxCell>

        <!-- Lyrics gate: ENABLED -->
        <mxCell id="g1" value="check lyricsOutputEnabled" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="160" as="sourcePoint" />
            <mxPoint x="330" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g1r" value="true ✓" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;fontColor=#009900;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="185" as="sourcePoint" />
            <mxPoint x="130" y="185" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g2" value="sendToMagic(&quot;/textler/lyrics/line&quot;, [...])" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="220" as="sourcePoint" />
            <mxPoint x="530" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g2b" value="→ Magic" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="240" as="sourcePoint" />
            <mxPoint x="720" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Shader gate: DISABLED -->
        <mxCell id="g3" value="check shaderOutputEnabled" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="310" as="sourcePoint" />
            <mxPoint x="330" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g3r" value="false ✗" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;fontColor=#CC0000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="335" as="sourcePoint" />
            <mxPoint x="130" y="335" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="g3note" value="SKIPPED: /shader/load&#xa;not sent to Magic" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="350" width="150" height="35" as="geometry" />
        </mxCell>

        <!-- Image gate: ENABLED -->
        <mxCell id="g4" value="check imageOutputEnabled" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="420" as="sourcePoint" />
            <mxPoint x="330" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g4r" value="true ✓" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;fontColor=#009900;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="445" as="sourcePoint" />
            <mxPoint x="130" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g5" value="sendToMagic(&quot;/image/folder&quot;, [path])" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="475" as="sourcePoint" />
            <mxPoint x="530" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g5b" value="→ Magic" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="495" as="sourcePoint" />
            <mxPoint x="720" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Summary -->
        <mxCell id="gate-summary" value="&lt;b&gt;Key Principle:&lt;/b&gt; Output gating is &lt;i&gt;orthogonal&lt;/i&gt; to&#xa;pipeline logic. The pipeline always runs fully,&#xa;but each output step checks its gate before&#xa;sending OSC. No pipeline code changes needed&#xa;to suppress any output category." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="340" height="85" as="geometry" />
        </mxCell>

        <mxCell id="gate-table" value="&lt;table style='font-size:10px'&gt;&#xa;&lt;tr&gt;&lt;th&gt;Gate&lt;/th&gt;&lt;th&gt;Address Group&lt;/th&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;shaderOutputEnabled&lt;/td&gt;&lt;td&gt;/shader/load&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;imageOutputEnabled&lt;/td&gt;&lt;td&gt;/image/*&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;lyricsOutputEnabled&lt;/td&gt;&lt;td&gt;/textler/lyrics/*, /textler/track&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;refrainOutputEnabled&lt;/td&gt;&lt;td&gt;/textler/refrain/*&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td&gt;songInfoOutputEnabled&lt;/td&gt;&lt;td&gt;/textler/metadata/*, /ai/*&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="560" width="300" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>